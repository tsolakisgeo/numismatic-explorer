corid:coin-1934-219
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-219" ;
    dcterms:source corid:card-COIN_X_1934_00219_X_sideA ;
    nmo:hasStartDate "-0400"^^xsd:gYear ;
    nmo:hasEndDate "-0344"^^xsd:gYear ;
    nmo:hasMint corid:mint-cierium ;
    nmo:hasMaterial nm:ae ;
    nmo:hasDiameter "20"^^xsd:decimal ;
