corid:place-agora-se
    skos:prefLabel "Agora Southeast"@en .

corid:coin-1934-219-obverse
    a nmo:Obverse ;
    dcterms:description "Laureate head of Poseidon right, with rolled hair"@en .

corid:coin-1934-219-reverse
    a nmo:Reverse ;
    nmo:hasLegend "(K)ERIEΩN" ;
    dcterms:description "Bridled horse prancing right; beneath, Arne kneeling left and playing with knucklebones"@en .

