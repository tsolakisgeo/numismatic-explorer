@prefix nmo: <http://nomisma.org/ontology#> .
@prefix cor: <https://example.org/corinth/ontology/> .
@prefix corid: <https://example.org/corinth/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

corid:coin-1934-368
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-368" ;
    dcterms:source corid:card-COIN_X_1934_00368_X_sideA ;
    nmo:hasObverse corid:coin-1934-368-obverse ;
    nmo:hasReverse corid:coin-1934-368-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00368_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00368_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-368 ;
    cor:sourceImageFilename "COIN_X_1934_00368_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-368" ;
    cor:inventoryNumber "1934-368" ;
    cor:groupRaw "Gru 16" ;
    cor:findspotRaw "Agora SW / Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-93-22/23" ;
    cor:photographicEvidence [
        a cor:CoinPhotographPair ;
        cor:leftPhotographDescription "Central architectural or monogram-like device with pellets, surrounded by an indistinct marginal legend." ;
        cor:rightPhotographDescription "Cross within an inner circular border, surrounded by an indistinct marginal legend."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 16" ;
        cor:proposedValue "Group 16" ;
        cor:reason "The abbreviated handwritten notation beside COIN is not fully explicit."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDateRaw" ;
        cor:rawValue "5/8/34" ;
        cor:reason "The numeric date could represent May 8 or 5 August 1934, so it has not been normalized."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "faceAssignment" ;
        cor:rawValue "Two pasted photographs without written obverse/reverse labels" ;
        cor:proposedValue "Left photograph as obverse; right photograph as reverse" ;
        cor:reason "The assignment follows the photographs' left-to-right placement and is not explicitly stated on the card."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that 'Gru 16' means Group 16, the interpretation of the date 5/8/34, and the assignment of the left photograph as obverse and the right photograph as reverse." .

corid:coin-1934-368-obverse
    a nmo:Obverse ;
    dcterms:description "Central architectural or monogram-like device with pellets, surrounded by an indistinct marginal legend."@en .

corid:coin-1934-368-reverse
    a nmo:Reverse ;
    dcterms:description "Cross within an inner circular border, surrounded by an indistinct marginal legend."@en .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW hoard"@en .
