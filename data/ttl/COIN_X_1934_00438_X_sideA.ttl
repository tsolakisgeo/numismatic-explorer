    nmo:hasObverse corid:coin-1934-438-obverse ;
    nmo:hasReverse corid:coin-1934-438-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00438_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00438_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-438 ;
    cor:sourceImageFilename "COIN_X_1934_00438_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-438" ;
    cor:inventoryNumber "1934-438" ;
