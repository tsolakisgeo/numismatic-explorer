    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-97-20/21" ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm whether 'Gru 86' expands to 'Group 86', whether 5/8/34 means May 8 or 5 August 1934, and whether the left and right photographs represent the obverse and reverse respectively." .

