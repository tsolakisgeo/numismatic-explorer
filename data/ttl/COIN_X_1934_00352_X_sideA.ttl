    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that the faint parenthetical reverse note reads 'no thyrsus nor panther'." .

corid:coin-1934-352-obverse
    a nmo:Obverse ;
    nmo:hasLegend "IMP CAES DOMIT ......" ;
    dcterms:description "Laureate head of Domitian facing right."@en .

corid:coin-1934-352-reverse
    a nmo:Reverse ;
    nmo:hasLegend "COL IVL AVG [COR]" ;
    dcterms:description "Dionysos stands left, wearing a himation around his loins, holding a kantharos in his right hand and leaning on a pillar."@en .

