corid:card-COIN_X_1934_00352_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00352_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-352 ;
    cor:sourceImageFilename "COIN_X_1934_00352_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-352" ;
    cor:inventoryNumber "1934-352" ;
    cor:earlierInventoryNumber "70" ;
    cor:authorityRaw "Domitian 81-96" ;
    cor:mintRaw "Corinth" ;
    cor:materialRaw "Æ" ;
    cor:diameterRaw "21" ;
    cor:obverseLegendRaw "IMP CAES DOMIT ......" ;
    cor:obverseTypeRaw "Head r., laureate" ;
    cor:reverseLegendRaw "COL IVL AVG [COR]" ;
    cor:reverseTypeRaw "Dionysos, wearing himation around his loins, standing l., holding kantharos in r., and leaning on pillar. (no thyrsus nor panther)" ;
    cor:findspotRaw "Agora SW" ;
    cor:excavationDateRaw "11/9/1934" ;
    cor:excavationDate "1934-11-09"^^xsd:date ;
    cor:notebookReference [
        a cor:ExcavationNotebookReference ;
