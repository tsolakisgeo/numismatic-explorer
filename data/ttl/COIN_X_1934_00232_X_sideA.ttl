    skos:prefLabel "Corinth"@en .

corid:study-collection
    a dcterms:Collection ;
    skos:prefLabel "Study Collection"@en .

corid:place-agora-se-pd1-south-stoa-shop-i
    skos:prefLabel "Agora Southeast, Pottery Deposit 1, South Stoa Shop I"@en .

corid:coin-1934-232-obverse
    a nmo:Obverse ;
    nmo:hasLegend "Ϙ" ;
    dcterms:description "Pegasus flying left, with koppa beneath"@en .

corid:coin-1934-232-reverse
    a nmo:Reverse ;
    dcterms:description "Trident; lily to left and possible grain of corn to right"@en ;
    nmo:hasControlmark corid:controlmark-1934-232-reverse .

corid:controlmark-1934-232-reverse
    skos:prefLabel "Lily to left; possible grain of corn to right"@en .

