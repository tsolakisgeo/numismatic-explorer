corid:card-COIN_X_1934_00238_X_sideA_etc
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00238_X_sideA_etc" ;
    cor:documentsNumismaticObject
        corid:coin-1934-238,
        corid:coin-1934-1031,
        corid:coin-1934-913,
        corid:coin-1934-912,
        corid:coin-1934-911 ;
    cor:sourceImageFilename "COIN_X_1934_00238_X_sideA_etc.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-238 + 4 others!" ;
    cor:inventoryNumber "1934-238" ;
    cor:relatedInventoryNumber "1934-1031", "1934-913", "1934-912", "1934-911" ;
    cor:secondaryNumberRaw "34" ;
    cor:dateRaw "Corinth 400-146" ;
    cor:materialRaw "Æ" ;
    cor:diameterRaw "11-12" ;
    cor:databaseDiameterRaw "11" ;
    cor:databaseWeightRaw "1.86" ;
    cor:obverseTypeRaw "Pegasos l.; Ϙ." ;
    cor:obverseLegendRaw "Ϙ" ;
    cor:reverseTypeRaw "Trident." ;
    cor:reverseLegendRaw "D - O" ;
    cor:reverseControlMarksRaw "to l.; to r., cornucopiae; dolphin up.?; oenochoe; bull-amphora [crossed out]; O; Running griffin! (intrusive???!!!); inc. figure in r." ;
    cor:multipleReferenceNoteRaw "1934-238 & 1934-1031" ;
    cor:studyCollectionMarkRaw "1934-238 = in Study Coll. =" ;
    cor:cardTransferNoteRaw
        "new card + envelope associated with 1934-913",
        "new card + envelope associated with 1934-912",
        "new card + envelope associated with 1934-911" ;
    cor:archivalNoteRaw "if there were 5 P/Ts, one now missing 2015/4/30" ;
    cor:annotationDateRaw "2015/4/30" ;
    cor:notebookReference [
        a cor:ExcavationNotebookReference ;
        cor:notebookReferenceRaw "O. Broneer p. 127 (1-7)" ;
        cor:notebookName "O. Broneer" ;
        cor:notebookPage 127 ;
        cor:notebookPageRaw "127" ;
        cor:notebookEntryOrRange "1-7" ;
        cor:notebookIdentificationMethod "explicit_on_card" ;
        cor:databaseNotebookReferenceRaw "Notebook 139 p.127, 1-7"
    ] ;
    cor:findspotRaw "Agora SE" ;
    cor:excavationDateRaw "3/28/1934" ;
    cor:excavationDate "1934-03-28"^^xsd:date ;
    cor:databaseExcavationDateRaw "3/23/1934" ;
    cor:databaseRecordNote "Originally on other card" ;
    cor:requiresHumanReview true ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDate" ;
        cor:rawValue "3/28/1934" ;
        cor:proposedValue "1934-03-28" ;
        cor:reason "The linked database gives 3/23/1934, which conflicts with the visible card."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "reverseControlMarkAssignment" ;
        cor:rawValue "to l.; to r., cornucopiae; dolphin up.?; oenochoe; bull-amphora [crossed out]; O; Running griffin! (intrusive???!!!); inc. figure in r." ;
        cor:reason "The card groups five inventory numbers, and the individual reverse symbols cannot be assigned securely to particular coins from the layout alone."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "diameter" ;
        cor:rawValue "11-12" ;
        cor:proposedValue "11" ;
        cor:reason "The card gives a range, while the linked database records 11 mm."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "cardTransferNotes" ;
        cor:rawValue "new card + envelope ... 1934-913; new card + envelope ... 1934-912; new card + envelope ... 1934-911" ;
        cor:reason "Some connecting words and the crossed-out red annotation are not fully legible."
    ] ;
    cor:databaseContext corid:metis-coin-1268188846 .

