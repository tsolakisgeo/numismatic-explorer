corid:coin-1934-214
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-214" ;
    dcterms:source corid:card-COIN_X_1934_00214_X_sideB ;
    nmo:hasStartDate "-0350"^^xsd:gYear ;
    nmo:hasEndDate "-0228"^^xsd:gYear ;
    nmo:hasMint corid:mint-argos ;
    nmo:hasMaterial nm:ar ;
    nmo:hasDenomination corid:denomination-obol ;
    nmo:hasWeight "0.86"^^xsd:decimal ;
