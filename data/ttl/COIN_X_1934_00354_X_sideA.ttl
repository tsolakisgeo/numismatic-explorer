@prefix nmo: <http://nomisma.org/ontology#> .
@prefix nm: <http://nomisma.org/id/> .
@prefix cor: <https://example.org/corinth/ontology/> .
@prefix corid: <https://example.org/corinth/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

corid:coin-1934-354
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-354" ;
    dcterms:source corid:card-COIN_X_1934_00354_X_sideA ;
    nmo:hasMaterial nm:ae ;
    nmo:hasObverse corid:coin-1934-354-obverse ;
    nmo:hasReverse corid:coin-1934-354-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00354_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00354_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-354 ;
    cor:sourceImageFilename "COIN_X_1934_00354_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-354" ;
    cor:inventoryNumber "1934-354" ;
    cor:groupRaw "Gru 2" ;
    cor:findspotRaw "Agora SW / Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:materialRaw "AE" ;
    cor:negativeNumberRaw "08-92-27/28" ;
    cor:photographicEvidence [
        a cor:CoinPhotographPair ;
        cor:leftPhotographDescription "Frontal stylized head or bust, possibly crowned or diademed, with an indistinct marginal legend." ;
        cor:rightPhotographDescription "Cross within a circular border, with an indistinct surrounding legend."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 2" ;
        cor:proposedValue "Group 2" ;
        cor:reason "The abbreviated handwritten notation beside COIN is not fully explicit."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDateRaw" ;
        cor:rawValue "5/8/34" ;
        cor:reason "The numeric date could represent May 8 or 5 August 1934, so it has not been normalized."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "faceAssignment" ;
        cor:rawValue "Two pasted photographs without written obverse/reverse labels" ;
        cor:proposedValue "Left photograph as obverse; right photograph as reverse" ;
        cor:reason "The assignment follows the photographs' left-to-right placement and is not explicitly stated on the card."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that 'Gru 2' means Group 2, the interpretation of the date 5/8/34, and the obverse/reverse assignment and iconographic descriptions of the two photographs." .

corid:coin-1934-354-obverse
    a nmo:Obverse ;
    dcterms:description "Frontal stylized head or bust, possibly crowned or diademed, with an indistinct marginal legend."@en .

corid:coin-1934-354-reverse
    a nmo:Reverse ;
    dcterms:description "Cross within a circular border, surrounded by an indistinct legend."@en .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW hoard"@en .
