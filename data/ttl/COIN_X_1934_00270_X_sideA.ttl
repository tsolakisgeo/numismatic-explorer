corid:mint-corinth
    a nmo:Mint ;
    skos:prefLabel "Corinth"@en .

corid:denomination-drachma
    a nmo:Denomination ;
    skos:prefLabel "Drachma"@en .

corid:study-collection
    a dcterms:Collection ;
