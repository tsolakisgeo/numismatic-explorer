    skos:prefLabel "Anonymous follis, Class K"@en .

corid:coin-1934-204-obverse
    a nmo:Obverse ;
    nmo:hasLegend "C, Φ, M, Δ" ;
    dcterms:description "Jeweled radiate cross on two steps, with letters C, Φ, M, and Δ in the angles; the ends of the limbs are decorated with globules"@en ;
    cor:overtypeRaw "Red drawing beside 'over:' showing a circular arrangement of globules" .

corid:coin-1934-204-reverse
    a nmo:Reverse ;
    dcterms:description "Bust of the emperor wearing stemma, divitision, and jeweled loros, holding a scepter cruciger in the right hand and a globus cruciger in the left"@en ;
    cor:overtypeRaw "-" .

corid:place-agora-southwest
    skos:prefLabel "Agora Southwest"@en .

