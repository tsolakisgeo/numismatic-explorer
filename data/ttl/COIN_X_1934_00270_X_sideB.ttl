corid:coin-1934-270-obverse
    a nmo:Obverse ;
    dcterms:description "Pegasus flying left; koppa beneath"@en ;
    nmo:hasControlmark corid:controlmark-koppa .

corid:coin-1934-270-reverse
    a nmo:Reverse ;
    dcterms:description "Head of Peirene or Aphrodite left, with rolled hair, earring, and necklace; letter A to right"@en ;
    nmo:hasControlmark corid:controlmark-letter-a .

corid:negative-74-81-9
