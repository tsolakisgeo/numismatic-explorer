@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

corid:coin-1934-356
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-356" ;
    dcterms:source corid:card-COIN_X_1934_00356_X_sideA ;
    nmo:hasAuthority corid:authority-alfonse-count-of-toulouse ;
    nmo:hasStartDate "1251"^^xsd:gYear ;
    nmo:hasEndDate "1262"^^xsd:gYear ;
    nmo:hasObverse corid:coin-1934-356-obverse ;
    nmo:hasReverse corid:coin-1934-356-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard ;
    nmo:hasCollection corid:study-collection .

corid:card-COIN_X_1934_00356_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00356_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-356 ;
    cor:sourceImageFilename "COIN_X_1934_00356_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-356" ;
    cor:inventoryNumber "1934-356" ;
    cor:groupRaw "Gru 4" ;
    cor:cardCategoryRaw "Frank. Ven." ;
    cor:authorityRaw "Alfonse, Count of Toulouse (1251-62)" ;
    cor:findspotRaw "Agora SW / Hoard" ;
    cor:excavationDateRaw "5/8/1934" ;
    cor:excavationDate "1934-05-08"^^xsd:date ;
    cor:collectionRaw "Study collection" ;
    cor:negativeNumberRaw "08-92-31/32" ;
    cor:photographicEvidence [
        a cor:CoinPhotographPair ;
        cor:leftPhotographDescription "Central monogram-like or architectural device within a marginal legend." ;
        cor:rightPhotographDescription "Cross within a circular border and marginal legend."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 4" ;
        cor:proposedValue "Group 4" ;
        cor:reason "The abbreviated handwritten notation beside COIN is not fully explicit."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "faceAssignment" ;
        cor:rawValue "Two pasted photographs without written obverse/reverse labels" ;
        cor:proposedValue "Left photograph as obverse; right photograph as reverse" ;
        cor:reason "The assignment follows the photographs' left-to-right placement and is not explicitly stated on the card."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that 'Gru 4' means Group 4 and that the left and right photographs represent the obverse and reverse respectively." .

corid:coin-1934-356-obverse
    a nmo:Obverse ;
    dcterms:description "Central monogram-like or architectural device within a marginal legend."@en .

corid:coin-1934-356-reverse
    a nmo:Reverse ;
    dcterms:description "Cross within a circular border and marginal legend."@en .

corid:authority-alfonse-count-of-toulouse
    a nmo:Authority ;
    skos:prefLabel "Alfonse, Count of Toulouse"@en ;
    cor:dateRangeRaw "1251-62" .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW hoard"@en .

corid:study-collection
    a dcterms:Collection ;
    skos:prefLabel "Study Collection"@en .
