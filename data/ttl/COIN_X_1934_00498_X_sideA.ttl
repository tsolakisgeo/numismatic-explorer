    nmo:hasReverse corid:coin-1934-498-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00498_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00498_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-498 ;
    cor:sourceImageFilename "COIN_X_1934_00498_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-498" ;
    cor:inventoryNumber "1934-498" ;
    cor:groupRaw "Gru 146" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-100-30/31" ;
    cor:databaseContext corid:metis-inventory-card-8786273932791396352,
                        corid:metis-coin-minus-1974801726 ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 146" ;
        cor:proposedValue "Group 146" ;
        cor:reason "The expansion of the handwritten abbreviation is inferred."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDateRaw" ;
        cor:rawValue "5/8/34" ;
        cor:reason "The date is legible, but the month-day order is not explicit on the card."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "photographFaceAssignment" ;
        cor:rawValue "Two unlabeled coin photographs, left and right" ;
        cor:proposedValue "left photograph = obverse; right photograph = reverse" ;
        cor:reason "The photographs are not explicitly assigned to the printed obverse and reverse fields."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the expansion of 'Gru 146', the calendar interpretation of 5/8/34, and the assignment of the left and right photographs to obverse and reverse." .

corid:coin-1934-498-obverse
    a nmo:Obverse ;
    dcterms:description "Unlabeled left photograph: worn coin face with an indistinct central monogrammatic or heraldic device and traces of a surrounding marginal legend."@en ;
    cor:photographPosition "left" .

corid:coin-1934-498-reverse
    a nmo:Reverse ;
    dcterms:description "Unlabeled right photograph: coin face with a central cross-like device within a circular border and traces of a surrounding marginal legend."@en ;
    cor:photographPosition "right" .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .

