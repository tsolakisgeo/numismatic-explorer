corid:coin-1934-508
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-508" ;
    dcterms:source corid:card-COIN_X_1934_00508_X_sideA ;
    nmo:hasObverse corid:coin-1934-508-obverse ;
    nmo:hasReverse corid:coin-1934-508-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00508_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00508_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-508 ;
    cor:sourceImageFilename "COIN_X_1934_00508_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-508" ;
    cor:inventoryNumber "1934-508" ;
    cor:earlierInventoryNumber "Gru 156" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-101-13A/14A" ;
    cor:databaseContext corid:metis-inventory-card-8451683663112036352,
                        corid:metis-coin-minus-123637181 ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "photographFaceAssignment" ;
        cor:rawValue "Two unlabeled coin photographs, left and right" ;
        cor:proposedValue "left photograph = obverse; right photograph = reverse" ;
        cor:reason "The photographs are not explicitly assigned to the printed obverse and reverse fields."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the assignment of the left and right photographs to obverse and reverse." .

corid:coin-1934-508-obverse
    a nmo:Obverse ;
    dcterms:description "Face shown in the left photograph, provisionally treated as the obverse; a central monogrammatic or heraldic device is surrounded by a marginal legend."@en ;
    cor:photographPosition "left" .

corid:coin-1934-508-reverse
    a nmo:Reverse ;
    dcterms:description "Face shown in the right photograph, provisionally treated as the reverse; a central cross-like device is surrounded by a marginal legend."@en ;
    cor:photographPosition "right" .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .

