    cor:authorityRaw "Augustus - 27 B.C. - 14 A.D." ;
    cor:dateAssignmentRaw "2 B.C. → 14 A.D." ;
    cor:mintRaw "Lugdunum" ;
    cor:materialRaw "AR" ;
    cor:denominationRaw "den." ;
    cor:obverseLegendRaw "[CAESAR. AVGVSTVS / DIVI. F. PATER. PATRIAE" ;
    cor:obverseLegendNormalized "CAESAR AVGVSTVS DIVI F PATER PATRIAE" ;
    cor:obverseTypeRaw "Head laureate r." ;
    cor:reverseLegendRaw "C. L. CAESARES (in ex.) [AVGVSTI] / F. CO[S. DESIG.] PRINC. IVVENT." ;
    cor:reverseLegendNormalized "C L CAESARES / AVGVSTI F COS DESIG PRINC IVVENT" ;
    cor:reverseTypeRaw "Gaius and Lucius standing, each holding spear + shield; in field (above) simpulum (l.) and lituus (r.)." ;
    cor:reverseSymbolRaw "simpulum (l.) and lituus (r.)" ;
    cor:findspotRaw "Agora SW" ;
    cor:excavationDateRaw "10/24/1934" ;
    cor:excavationDate "1934-10-24"^^xsd:date ;
    cor:notebookReference [
        a cor:ExcavationNotebookReference ;
        cor:notebookReferenceRaw "NB 144; G. R. Davidson p. 117 (13-16)" ;
