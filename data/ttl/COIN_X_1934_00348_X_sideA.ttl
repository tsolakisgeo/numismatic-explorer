corid:coin-1934-348-obverse
    a nmo:Obverse ;
    nmo:hasLegend "[CAESAR. AVGVSTVS / DIVI. F. PATER. PATRIAE" ;
    dcterms:description "Laureate head of Augustus facing right."@en .

corid:coin-1934-348-reverse
    a nmo:Reverse ;
    nmo:hasLegend "C. L. CAESARES (in ex.) [AVGVSTI] / F. CO[S. DESIG.] PRINC. IVVENT." ;
    dcterms:description "Gaius and Lucius stand facing, each holding a spear and shield; a simpulum appears above on the left and a lituus above on the right."@en .

