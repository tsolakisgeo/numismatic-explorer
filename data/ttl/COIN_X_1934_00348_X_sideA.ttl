        cor:notebookName "G. R. Davidson" ;
        cor:notebookPage "117"^^xsd:integer ;
        cor:notebookEntryOrRange "13-16" ;
        cor:notebookIdentificationMethod "explicit_on_card"
    ] ;
    cor:supersededBibliographicCitation "RIC I, p. 90, no. 350" ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "obverseLegendRaw" ;
        cor:rawValue "[CAESAR. AVGVSTVS / DIVI. F. PATER. PATRIAE" ;
        cor:reason "The opening bracket marks a restored portion, but the precise extent of the restoration is not fully explicit."
    ] ;
