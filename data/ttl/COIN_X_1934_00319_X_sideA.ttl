    cor:studyCollectionRaw "in STUDY COLL." ;
    cor:negativeReferenceRaw "Neg. 92-56-30/31" ;
    cor:photographicNegative corid:negative-92-56-30 ;
    cor:photographicNegative corid:negative-92-56-31 ;
