corid:coin-1934-319
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-319" ;
    dcterms:source corid:card-COIN_X_1934_00319_X_sideA ;
    nmo:hasMaterial corid:material-billon ;
    nmo:hasDenomination corid:denomination-jeton ;
    nmo:hasDiameter "21"^^xsd:decimal ;
    nmo:hasWeight "0.92"^^xsd:decimal ;
    nmo:hasAxis 9 ;
    nmo:hasObverse corid:coin-1934-319-obverse ;
    nmo:hasReverse corid:coin-1934-319-reverse ;
    nmo:hasFindspot corid:place-agora-sw ;
    nmo:hasCollection corid:study-collection ;
    cor:conditionRaw "broken" ;
    cor:axisAssignmentBasis "Linked coin database; the axis is not written on the card." .

corid:material-billon
    a nmo:Material ;
    skos:prefLabel "Billon"@en .

corid:denomination-jeton
    a nmo:Denomination ;
    skos:prefLabel "Jeton"@en .

corid:place-agora-sw
    skos:prefLabel "Agora SW"@en .

corid:study-collection
    a dcterms:Collection ;
    skos:prefLabel "Study Collection"@en .

corid:coin-1934-319-obverse
    a nmo:Obverse ;
    dcterms:description "Row of dots between two lines within a circle, with a cross over a monogram"@en .

corid:coin-1934-319-reverse
    a nmo:Reverse ;
    dcterms:description "Same design as the obverse: row of dots between two lines within a circle, with a cross over a monogram"@en .

corid:negative-92-56-30
    a cor:PhotographicNegative ;
    dcterms:identifier "92-56-30" ;
    cor:depictsNumismaticObject corid:coin-1934-319 .

corid:negative-92-56-31
    a cor:PhotographicNegative ;
    dcterms:identifier "92-56-31" ;
    cor:depictsNumismaticObject corid:coin-1934-319 .

corid:photo-print-1934-319-left
    a cor:PhotographicPrint ;
    cor:mountedOnCard corid:card-COIN_X_1934_00319_X_sideA ;
    cor:depictsNumismaticObject corid:coin-1934-319 ;
    cor:positionOnCard "lower centre-left" .

corid:photo-print-1934-319-right
    a cor:PhotographicPrint ;
    cor:mountedOnCard corid:card-COIN_X_1934_00319_X_sideA ;
    cor:depictsNumismaticObject corid:coin-1934-319 ;
    cor:positionOnCard "lower centre-right" .

