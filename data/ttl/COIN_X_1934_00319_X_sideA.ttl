    cor:excavationDate "1934-05-14"^^xsd:date ;
    cor:notebookReference [
        a cor:ExcavationNotebookReference ;
        cor:notebookReferenceRaw "NB 143; G. R. Davidson p. 104 (3-4)" ;
        cor:notebookNumber 143 ;
