    cor:attachedPhotograph corid:photo-print-1934-319-right ;
    cor:photographDescriptionRaw "Two attached black-and-white photographs showing the two faces of the broken jeton." ;
    cor:databaseCoinId "-988834412" ;
    cor:databaseDepartmentRaw "ME" ;
    cor:databaseObverseTypeRaw "Row of dots between two lines; within circle; cross on monogram" ;
    cor:databaseReverseTypeRaw "Same as obverse" ;
    cor:databaseMaterialRaw "AE" ;
    cor:databaseDenominationRaw "Jeton" ;
    cor:databaseWeightRaw "0.92" ;
    cor:databaseDiameterRaw "21" ;
    cor:databaseAxisRaw "9" ;
    cor:databaseExcavationContextRaw "Agora SW; excavation date 5/14/1934; Notebook 143 p.104, 3-4" ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the faint earlier number '1285', the material disagreement between the card ('Billon') and database ('AE'), and the assignment of negatives 92-56-30 and 92-56-31 to the two attached photographs." ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "earlierInventoryNumber" ;
        cor:rawValue "1285" ;
        cor:reason "The small pencil number at the upper left is faint."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "material" ;
        cor:rawValue "Billon" ;
        cor:proposedValue "AE" ;
        cor:reason "The card explicitly reads 'Billon', while the linked database records AE; the card reading is retained as primary."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "negativeToPhotographAssignment" ;
        cor:rawValue "92-56-30/31" ;
        cor:reason "The combined negative notation is visible, but the individual assignment of each negative to the left or right photograph is not explicit."
    ] .
