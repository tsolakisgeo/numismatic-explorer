corid:coin-1934-212
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-212" ;
    dcterms:source corid:card-COIN_X_1934_00212_X_sideA ;
    nmo:hasStartDate "-0400"^^xsd:gYear ;
    nmo:hasEndDate "-0146"^^xsd:gYear ;
    nmo:hasMint corid:mint-corinth ;
    nmo:hasMaterial nm:ae ;
    nmo:hasDiameter "13"^^xsd:decimal ;
    nmo:hasWeight "1.81"^^xsd:decimal ;
    nmo:hasShape corid:shape-oval-flan ;
    nmo:hasObverse corid:coin-1934-212-obverse ;
    nmo:hasReverse corid:coin-1934-212-reverse ;
    nmo:hasFindspot corid:place-agora-se ;
    nmo:hasCollection corid:study-collection .

corid:mint-corinth
    a nmo:Mint ;
    skos:prefLabel "Corinth"@en .

corid:shape-oval-flan
    a nmo:Shape ;
    skos:prefLabel "Oval flan"@en .

corid:study-collection
    a dcterms:Collection ;
    skos:prefLabel "Study Collection"@en .

corid:place-agora-se
    skos:prefLabel "Agora Southeast"@en .

corid:coin-1934-212-obverse
    a nmo:Obverse ;
    dcterms:description "Pegasus"@en .

corid:coin-1934-212-reverse
    a nmo:Reverse ;
    nmo:hasLegend "Σ" ;
    dcterms:description "Trident, with Σ to left and caduceus to right"@en ;
    nmo:hasControlmark corid:controlmark-1934-212-reverse .

corid:controlmark-1934-212-reverse
    skos:prefLabel "Σ to left; caduceus to right"@en .

