    cor:documentsNumismaticObject corid:coin-1934-212 ;
    cor:sourceImageFilename "COIN_X_1934_00212_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-212" ;
