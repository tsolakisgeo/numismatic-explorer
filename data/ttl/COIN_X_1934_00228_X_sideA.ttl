corid:place-agora-se
    skos:prefLabel "Agora Southeast"@en .

corid:coin-1934-228-obverse
    a nmo:Obverse ;
    nmo:hasLegend "Ϙ" ;
    dcterms:description "Pegasus left, with koppa beneath"@en .

corid:coin-1934-228-reverse
    a nmo:Reverse ;
    nmo:hasLegend "Δ" ;
    dcterms:description "Trident, with Δ to the left and an oinochoe to the right"@en ;
    nmo:hasControlmark corid:controlmark-1934-228-reverse .

corid:controlmark-1934-228-reverse
    skos:prefLabel "Δ to left; oinochoe to right"@en .

