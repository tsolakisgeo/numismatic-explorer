corid:authority-tiberius-ii
    a nmo:Authority ;
    skos:prefLabel "Tiberius II Constantine"@en .

corid:mint-constantinople
    a nmo:Mint ;
    skos:prefLabel "Constantinople"@en .

corid:denomination-follis
    a nmo:Denomination ;
    skos:prefLabel "Follis"@en .

corid:study-collection
    a dcterms:Collection ;
    skos:prefLabel "Study Collection"@en .

corid:place-agora-sw
    skos:prefLabel "Agora Southwest"@en .

corid:coin-1934-225-obverse
    a nmo:Obverse ;
    nmo:hasLegend "dM TIb CON STANT PP AVI" ;
    dcterms:description "Facing bust of Tiberius II, holding a mappa in the uplifted right hand and a sceptre surmounted by an eagle in the left; cross above the eagle"@en .

corid:coin-1934-225-reverse
    a nmo:Reverse ;
    nmo:hasLegend "ANNO / M / CONA" ;
    dcterms:description "Large M with cross above; ANNO vertically to left, regnal-year mark to right, and CONA in the exergue"@en ;
    nmo:hasMintmark corid:mintmark-cona .

corid:mintmark-cona
    skos:prefLabel "CONA"@en .

