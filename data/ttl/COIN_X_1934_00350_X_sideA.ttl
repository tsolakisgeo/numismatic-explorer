corid:coin-1934-350
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-350" ;
    dcterms:source corid:card-COIN_X_1934_00350_X_sideA ;
    nmo:hasAuthority corid:authority-charles-i-of-anjou ;
    nmo:hasStartDate "1266"^^xsd:gYear ;
    nmo:hasEndDate "1278"^^xsd:gYear ;
    nmo:hasMaterial nm:ae ;
    nmo:hasDenomination corid:denomination-denaro ;
    nmo:hasMint corid:mint-brindisi ;
    nmo:hasWeight "0.605"^^xsd:decimal ;
    nmo:hasObverse corid:coin-1934-350-obverse ;
    nmo:hasReverse corid:coin-1934-350-reverse ;
