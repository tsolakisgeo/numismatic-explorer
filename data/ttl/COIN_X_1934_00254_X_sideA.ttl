corid:coin-1934-254
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-254" ;
    dcterms:source corid:card-COIN_X_1934_00254_X_sideA ;
    nmo:hasStartDate "-0400"^^xsd:gYear ;
    nmo:hasEndDate "-0048"^^xsd:gYear ;
    nmo:hasMint corid:mint-corcyra ;
    nmo:hasMaterial nm:ae ;
    nmo:hasDiameter "26"^^xsd:decimal ;
    nmo:hasObverse corid:coin-1934-254-obverse ;
    nmo:hasReverse corid:coin-1934-254-reverse ;
    nmo:hasFindspot corid:place-agora-sw ;
    nmo:hasCollection corid:study-collection ;
    dcterms:bibliographicCitation "B.M.C. (Thes.), p. 152, nos. 559-560" .

corid:mint-corcyra
    a nmo:Mint ;
    skos:prefLabel "Corcyra"@en .

corid:study-collection
    a dcterms:Collection ;
    skos:prefLabel "Study Collection"@en .

corid:place-agora-sw
    skos:prefLabel "Agora Southwest"@en .

corid:coin-1934-254-obverse
    a nmo:Obverse ;
    dcterms:description "Jugate heads right of laureate Herakles and Corcyra wearing an ivy wreath; bucranium countermark"@en ;
    nmo:hasControlmark corid:countermark-1934-254-bucranium .

corid:countermark-1934-254-bucranium
    skos:prefLabel "Bucranium countermark"@en .

corid:coin-1934-254-reverse
    a nmo:Reverse ;
    nmo:hasLegend "[ΚΟΡ]ΚΥΡΑΙΩΝ [ΦΙΛ]ΩΤΑΣ" ;
    dcterms:description "Forepart of galley right; dolphin left below, uncertain"@en ;
    nmo:hasControlmark corid:controlmark-1934-254-dolphin .

corid:controlmark-1934-254-dolphin
    skos:prefLabel "Dolphin left below the galley, uncertain"@en .

