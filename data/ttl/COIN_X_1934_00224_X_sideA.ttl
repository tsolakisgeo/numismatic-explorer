corid:coin-1934-224
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-224" ;
    dcterms:source corid:card-COIN_X_1934_00224_X_sideA ;
    nmo:hasStartDate "-0400"^^xsd:gYear ;
    nmo:hasEndDate "-0146"^^xsd:gYear ;
    nmo:hasMint corid:mint-corinth ;
    nmo:hasMaterial nm:ae ;
    nmo:hasDiameter "12"^^xsd:decimal ;
    nmo:hasObverse corid:coin-1934-224-obverse ;
    nmo:hasReverse corid:coin-1934-224-reverse ;
    nmo:hasFindspot corid:place-agora-se ;
    nmo:hasCollection corid:study-collection .

corid:mint-corinth
    a nmo:Mint ;
    skos:prefLabel "Corinth"@en .

corid:study-collection
    a dcterms:Collection ;
    skos:prefLabel "Study Collection"@en .

corid:place-agora-se
    skos:prefLabel "Agora Southeast"@en .

corid:coin-1934-224-obverse
    a nmo:Obverse ;
    nmo:hasLegend "Ϙ" ;
    dcterms:description "Pegasus left; koppa in the field"@en .

corid:coin-1934-224-reverse
    a nmo:Reverse ;
    nmo:hasLegend "A" ;
    dcterms:description "Trident, with A to the left and a possible wreath to the right"@en ;
    nmo:hasControlmark corid:controlmark-1934-224-reverse .

corid:controlmark-1934-224-reverse
    skos:prefLabel "A to left; possible wreath to right"@en .

