    cor:potteryDepositReference "PD 1934-1" ;
    cor:findspotRaw "Agora SE" ;
    cor:excavationDateRaw "3/13/1934" ;
    cor:excavationDate "1934-03-13"^^xsd:date ;
    cor:notebookReference [
