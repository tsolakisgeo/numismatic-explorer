@prefix nmo: <http://nomisma.org/ontology#> .
@prefix cor: <https://example.org/corinth/ontology/> .
@prefix corid: <https://example.org/corinth/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

corid:coin-1934-367
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-367" ;
    dcterms:source corid:card-COIN_X_1934_00367_X_sideA ;
    nmo:hasObverse corid:coin-1934-367-obverse ;
    nmo:hasReverse corid:coin-1934-367-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00367_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00367_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-367 ;
    cor:sourceImageFilename "COIN_X_1934_00367_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-367" ;
    cor:inventoryNumber "1934-367" ;
    cor:groupRaw "Gru 15" ;
    cor:findspotRaw "Agora SW / Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-93-20/21" ;
    cor:photographicEvidence [
        a cor:CoinPhotographPair ;
        cor:leftPhotographDescription "Cross within an inner circular border, surrounded by an indistinct marginal legend." ;
        cor:rightPhotographDescription "Central architectural or monogram-like device with pellets, surrounded by an indistinct marginal legend."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 15" ;
        cor:proposedValue "Group 15" ;
        cor:reason "The abbreviated handwritten notation beside COIN is not fully explicit."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDateRaw" ;
        cor:rawValue "5/8/34" ;
        cor:reason "The numeric date could represent May 8 or 5 August 1934, so it has not been normalized."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "faceAssignment" ;
        cor:rawValue "Two pasted photographs without written obverse/reverse labels" ;
        cor:proposedValue "Right photograph as obverse; left photograph as reverse" ;
        cor:reason "The proposed assignment is based on the architectural or monogram-like type on the right and the cross type on the left, not on written labels."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that 'Gru 15' means Group 15, the interpretation of the date 5/8/34, and the proposed assignment of the right photograph as obverse and the left photograph as reverse." .

corid:coin-1934-367-obverse
    a nmo:Obverse ;
    dcterms:description "Central architectural or monogram-like device with pellets, surrounded by an indistinct marginal legend."@en .

corid:coin-1934-367-reverse
    a nmo:Reverse ;
    dcterms:description "Cross within an inner circular border, surrounded by an indistinct marginal legend."@en .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW hoard"@en .
