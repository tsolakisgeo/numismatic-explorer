@prefix nmo: <http://nomisma.org/ontology#> .
@prefix nm: <http://nomisma.org/id/> .
@prefix cor: <https://example.org/corinth/ontology/> .
@prefix corid: <https://example.org/corinth/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

corid:coin-1934-440
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-440" ;
    dcterms:source corid:card-COIN_X_1934_00440_X_sideA ;
    nmo:hasObverse corid:coin-1934-440-obverse ;
    nmo:hasReverse corid:coin-1934-440-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00440_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00440_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-440 ;
    cor:sourceImageFilename "COIN_X_1934_00440_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-440" ;
    cor:inventoryNumber "1934-440" ;
    cor:groupRaw "Gru 88" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5-8-34" ;
    cor:negativeNumberRaw "08-97-24/25" ;
    cor:photographAnnotationRaw "wrong photo" ;
    cor:photographNumberRaw "08-97-23" ;
    cor:requiresHumanReview true ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "rightPhotographAssociation" ;
        cor:rawValue "wrong photo" ;
        cor:reason "The right-hand coin photograph is explicitly annotated as the wrong photograph."
    ] ;
    cor:humanConfirmationNote "Confirm whether 'Gru 88' means Group 88, whether 5-8-34 is May 8 or 5 August 1934, whether the vertical reading is 08-97-23, and which photograph correctly belongs to coin 1934-440." .

corid:coin-1934-440-obverse
    a nmo:Obverse ;
    dcterms:description "Worn central monogrammatic or architectural device with traces of a surrounding marginal legend, as shown in the left-hand photograph."@en .

corid:coin-1934-440-reverse
    a nmo:Reverse ;
    dcterms:description "Cross-like central device with traces of a surrounding marginal legend, as shown in the right-hand photograph; this photograph is annotated 'wrong photo' on the card."@en .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .
