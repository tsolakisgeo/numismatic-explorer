    cor:authorityRaw "Theodore I, Comn.-Lascaris, Emp. Nicaea, 1208-1222" ;
    cor:supersededAttributionRaw "John II, 1118-1143" ;
    cor:materialRaw "Æ" ;
    cor:diameterRaw "18" ;
    cor:axisRaw "downward arrow" ;
    cor:shapeRaw "scyph." ;
    cor:weightRaw "0.745 gs." ;
    cor:obverseLegendRaw "XC" ;
    cor:obverseTypeRaw "Christ seated facing on throne without back; right hand raised in benediction; left hand holding Book marked with four pellets; asterisk in field above" ;
    cor:reverseLegendRaw "ιω ... K" ;
    cor:reverseTypeRaw "Emperor standing facing, holding in right hand sceptre-cruciger; in left, globus cr. (?); manus Dei crowning him from right" ;
    cor:findspotRaw "Christian Basilica (C.C.G.), from narthex-wall" ;
    cor:excavationDateRaw "11/6/1934" ;
    cor:excavationDate "1934-06-11"^^xsd:date ;
    cor:notebookReference [
        a cor:ExcavationNotebookReference ;
        cor:notebookReferenceRaw "Pearce-Shelley p. 165-21" ;
        cor:notebookName "Pearce-Shelley" ;
        cor:notebookPage "165"^^xsd:integer ;
        cor:notebookEntryOrRange "21" ;
        cor:notebookIdentificationMethod "explicit_on_card"
    ] ;
    cor:cataloguerNoteRaw "new type?" ;
    cor:databaseDisagreement [
        a cor:SourceDisagreement ;
        cor:field "reverseType" ;
        cor:cardValue "Emperor standing facing, holding in right hand sceptre-cruciger; in left, globus cr. (?); manus Dei crowning him from right" ;
        cor:databaseValue "Full-length figure of emperor holding a sceptre cruciger in the right hand and an anexikakia in the left; Manus Dei in the upper right field" ;
        cor:reason "The card tentatively identifies the left-hand object as a globus cruciger, while the linked database record identifies it as an anexikakia."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "reverseLegendRaw" ;
        cor:rawValue "ιω ... K" ;
        cor:reason "Only faint, isolated legend fragments are visible."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "findspotRaw" ;
        cor:rawValue "Christian Basilica (C.C.G.), from narthex-wall" ;
        cor:reason "The parenthetical abbreviation appears to read C.C.G., but the handwriting is not fully clear."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the faint reverse legend fragments ('ιω' and 'K'), whether the emperor's left-hand object is a globus cruciger or an anexikakia, and the parenthetical findspot abbreviation 'C.C.G.'." .

corid:coin-1934-343-obverse
    a nmo:Obverse ;
    nmo:hasLegend "XC" ;
    dcterms:description "Christ seated facing on a backless throne, raising the right hand in benediction and holding a book marked with four pellets in the left; an asterisk appears in the field above."@en .

