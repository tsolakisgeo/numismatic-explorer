    a nmo:Reverse ;
    nmo:hasLegend "ιω ... K" ;
    dcterms:description "Emperor standing facing, holding a sceptre cruciger in the right hand and a tentatively identified globus cruciger in the left; the Manus Dei crowns him from the right."@en .

