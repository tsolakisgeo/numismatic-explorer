corid:coin-1934-500
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-500" ;
    dcterms:source corid:card-COIN_X_1934_00500_X_sideA ;
    nmo:hasObverse corid:coin-1934-500-obverse ;
    nmo:hasReverse corid:coin-1934-500-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00500_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00500_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-500 ;
    cor:sourceImageFilename "COIN_X_1934_00500_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-500" ;
    cor:inventoryNumber "1934-500" ;
    cor:earlierInventoryNumber "Gru 148" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-100-34/35" ;
    cor:databaseContext corid:metis-inventory-card-3007708331726606336,
                        corid:metis-coin-minus-782223934 ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "earlierInventoryNumber" ;
        cor:rawValue "Gru 148" ;
        cor:proposedValue "Group 148" ;
        cor:reason "The expansion of the handwritten abbreviation 'Gru' is inferred."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "photographFaceAssignment" ;
        cor:rawValue "Two unlabeled coin photographs, left and right" ;
        cor:proposedValue "left photograph = obverse; right photograph = reverse" ;
        cor:reason "The photographs are not explicitly labeled as obverse and reverse."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the expansion of 'Gru 148' and the assignment of the left and right photographs to obverse and reverse." .

corid:coin-1934-500-obverse
    a nmo:Obverse ;
    dcterms:description "Photograph provisionally assigned as the obverse: a central monogrammatic or heraldic device with a surrounding marginal legend."@en ;
    cor:photographPosition "left" .

corid:coin-1934-500-reverse
    a nmo:Reverse ;
    dcterms:description "Photograph provisionally assigned as the reverse: a central cross-like device within a circular border, with a surrounding marginal legend."@en ;
    cor:photographPosition "right" .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .

