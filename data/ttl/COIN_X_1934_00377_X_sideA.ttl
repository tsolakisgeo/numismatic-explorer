@prefix nmo: <http://nomisma.org/ontology#> .
@prefix cor: <https://example.org/corinth/ontology/> .
@prefix corid: <https://example.org/corinth/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

corid:coin-1934-377
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-377" ;
    dcterms:source corid:card-COIN_X_1934_00377_X_sideA ;
    nmo:hasObverse corid:coin-1934-377-obverse ;
    nmo:hasReverse corid:coin-1934-377-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00377_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00377_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-377 ;
    cor:sourceImageFilename "COIN_X_1934_00377_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-377" ;
    cor:inventoryNumber "1934-377" ;
    cor:groupRaw "Gru 25" ;
    cor:findspotRaw "Agora SW / Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-94-3A/4A" ;
    cor:photographicEvidence [
        a cor:CoinPhotographPair ;
        cor:leftPhotographDescription "Central architectural or monogram-like device with pellets, surrounded by an indistinct marginal legend." ;
        cor:rightPhotographDescription "Cross within an inner circular border, surrounded by an indistinct marginal legend."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that 'Gru 25' means Group 25, whether 5/8/34 is May 8 or 5 August 1934, the exact negative number 08-94-3A/4A, and whether the left and right photographs represent the obverse and reverse respectively." .

corid:coin-1934-377-obverse
    a nmo:Obverse ;
    dcterms:description "Central architectural or monogram-like device with pellets, surrounded by an indistinct marginal legend."@en .

corid:coin-1934-377-reverse
    a nmo:Reverse ;
    dcterms:description "Cross within an inner circular border, surrounded by an indistinct marginal legend."@en .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW hoard"@en .
