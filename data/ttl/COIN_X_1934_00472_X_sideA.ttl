corid:coin-1934-472
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-472" ;
    dcterms:source corid:card-COIN_X_1934_00472_X_sideA ;
    nmo:hasObverse corid:coin-1934-472-obverse ;
    nmo:hasReverse corid:coin-1934-472-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00472_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00472_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-472 ;
    cor:sourceImageFilename "COIN_X_1934_00472_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-472" ;
    cor:inventoryNumber "1934-472" ;
    cor:groupRaw "Gru 120" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-99-15A/16A" ;
    cor:leftPhotographDescription "Worn coin face with an indistinct central device and traces of a surrounding marginal legend."@en ;
    cor:rightPhotographDescription "Worn coin face with a central circular or monogrammatic device and traces of a surrounding marginal legend."@en ;
    cor:databaseLookupSource "direct_csv_index" ;
    cor:databaseLinkMethod "composite_inventory_key" ;
    cor:databaseInventoryCardID "2868060556459110400" ;
    cor:databaseLinkedCoinID "-1699193258" ;
    cor:databaseStudyCollectionStatus false ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 120" ;
        cor:proposedValue "Group 120" ;
        cor:reason "The expansion of the handwritten abbreviation is inferred."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDateRaw" ;
        cor:rawValue "5/8/34" ;
        cor:reason "The card does not make the month-day order explicit."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "photographFaceAssignment" ;
        cor:rawValue "Two unlabeled coin photographs, left and right" ;
        cor:proposedValue "left photograph = obverse; right photograph = reverse" ;
        cor:reason "The photographs are not explicitly labeled on the card."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm whether 'Gru 120' means 'Group 120', whether 5/8/34 is May 8 or 5 August 1934, and the assignment of the two photographs to obverse and reverse." .

corid:coin-1934-472-obverse
    a nmo:Obverse .

corid:coin-1934-472-reverse
