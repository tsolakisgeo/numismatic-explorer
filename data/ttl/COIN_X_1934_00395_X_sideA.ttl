@prefix nmo: <http://nomisma.org/ontology#> .
@prefix nm: <http://nomisma.org/id/> .
@prefix cor: <https://example.org/corinth/ontology/> .
@prefix corid: <https://example.org/corinth/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

corid:coin-1934-395
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-395" ;
    dcterms:source corid:card-COIN_X_1934_00395_X_sideA ;
    nmo:hasObverse corid:coin-1934-395-obverse ;
    nmo:hasReverse corid:coin-1934-395-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00395_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00395_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-395 ;
    cor:sourceImageFilename "COIN_X_1934_00395_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-395" ;
    cor:inventoryNumber "1934-395" ;
    cor:groupRaw "Gru 43" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-95-4/5" ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 43" ;
        cor:proposedValue "Group 43" ;
        cor:reason "The handwritten abbreviation is not expanded on the card."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDateRaw" ;
        cor:rawValue "5/8/34" ;
        cor:reason "The numeric date could represent May 8 or 5 August 1934."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "faceAssignment" ;
        cor:rawValue "Two pasted photographs without written obverse/reverse labels" ;
        cor:proposedValue "Left photograph as obverse; right photograph as reverse" ;
        cor:reason "The assignment follows the photographs' placement and is not explicitly stated on the card."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that 'Gru 43' means Group 43, the interpretation of 5/8/34, and the proposed left-obverse/right-reverse assignment." .

corid:coin-1934-395-obverse
    a nmo:Obverse ;
    dcterms:description "Very worn central bust-like or monogrammatic device surrounded by a partial marginal legend."@en .

corid:coin-1934-395-reverse
    a nmo:Reverse ;
    dcterms:description "Very worn cross-like central device surrounded by a partial marginal legend."@en .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .
