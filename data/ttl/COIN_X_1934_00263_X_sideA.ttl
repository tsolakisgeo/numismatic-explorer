    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the overwritten date '24/23 (?) BC' versus the corrected '30 BC (AMANDRY VII)', the exact obverse legend and parenthetical annotation, the abbreviated issuer introduction 'V. a.', and the database excavation year 1943 versus the card's 1934." ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "dateRaw" ;
        cor:rawValue "24/23 (?) BC" ;
        cor:proposedValue "30 BC" ;
        cor:reason "The first date is overwritten, while a later card annotation and the database give 30 BC."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "obverseLegendRaw" ;
        cor:rawValue "M· AN· TEO IIQ" ;
        cor:proposedValue "MAT TEO II Q" ;
        cor:reason "The handwritten letter groups and separators are ambiguous; the proposed form is the database transcription."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "obverseLegendAnnotationRaw" ;
        cor:rawValue "(a IIVIR Q?)" ;
        cor:reason "The parenthetical annotation beneath the obverse legend is partly unclear."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "issuerRaw" ;
        cor:rawValue "V. a. M. Antonius Theophilus + P. Aebutius" ;
        cor:reason "The abbreviated introduction before the two magistrates' names is not securely expanded."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "databaseExcavationContextRaw" ;
        cor:rawValue "Excavation Date: 4/18/1943" ;
        cor:proposedValue "4/18/1934" ;
        cor:reason "The card clearly gives 1934, so the database year appears inconsistent."
    ] .
