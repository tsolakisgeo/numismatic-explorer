@prefix nmo: <http://nomisma.org/ontology#> .
@prefix nm: <http://nomisma.org/id/> .
@prefix cor: <https://example.org/corinth/ontology/> .
@prefix corid: <https://example.org/corinth/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

corid:coin-1934-390
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-390" ;
    dcterms:source corid:card-COIN_X_1934_00390_X_sideA ;
    nmo:hasObverse corid:coin-1934-390-obverse ;
    nmo:hasReverse corid:coin-1934-390-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00390_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00390_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-390 ;
    cor:sourceImageFilename "COIN_X_1934_00390_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-390" ;
    cor:inventoryNumber "1934-390" ;
    cor:groupRaw "Gru 38" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-94-29A/30A" ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 38" ;
        cor:proposedValue "Group 38" ;
        cor:reason "The handwritten abbreviation is not expanded on the card."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDateRaw" ;
        cor:rawValue "5/8/34" ;
        cor:reason "The numeric date could represent May 8 or 5 August 1934."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "faceAssignment" ;
        cor:rawValue "Two pasted photographs without written obverse/reverse labels" ;
        cor:proposedValue "Left photograph as obverse; right photograph as reverse" ;
        cor:reason "The assignment follows the photographs' placement and is not explicitly stated on the card."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that 'Gru 38' means Group 38, the interpretation of 5/8/34, and the proposed left-obverse/right-reverse assignment." .

corid:coin-1934-390-obverse
    a nmo:Obverse ;
    dcterms:description "Central architectural or monogram-like device within a marginal legend."@en .

corid:coin-1934-390-reverse
    a nmo:Reverse ;
    dcterms:description "Cross within an inner circular border, surrounded by a marginal legend."@en .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .
