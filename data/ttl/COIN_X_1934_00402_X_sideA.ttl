corid:coin-1934-402
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-402" ;
    dcterms:source corid:card-COIN_X_1934_00402_X_sideA ;
    nmo:hasObverse corid:coin-1934-402-obverse ;
    nmo:hasReverse corid:coin-1934-402-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00402_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00402_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-402 ;
    cor:sourceImageFilename "COIN_X_1934_00402_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-402" ;
    cor:inventoryNumber "1934-402" ;
    cor:groupRaw "Gru 50" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-95-18/19" ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm that 'Gru 50' means Group 50, whether 5/8/34 is May 8 or 5 August 1934, and whether the left and right photographs represent the obverse and reverse respectively." .

corid:coin-1934-402-obverse
    a nmo:Obverse ;
    dcterms:description "Worn central architectural or monogram-like device surrounded by a partial marginal legend."@en .

corid:coin-1934-402-reverse
    a nmo:Reverse ;
    dcterms:description "Worn central cross-like or monogrammatic device surrounded by a partial marginal legend."@en .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .
