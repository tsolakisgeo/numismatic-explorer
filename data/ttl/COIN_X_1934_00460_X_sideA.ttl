@prefix nmo: <http://nomisma.org/ontology#> .
@prefix nm: <http://nomisma.org/id/> .
@prefix cor: <https://example.org/corinth/ontology/> .
@prefix corid: <https://example.org/corinth/id/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

corid:coin-1934-460
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-460" ;
    dcterms:source corid:card-COIN_X_1934_00460_X_sideA ;
    nmo:hasObverse corid:coin-1934-460-obverse ;
    nmo:hasReverse corid:coin-1934-460-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00460_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00460_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-460 ;
    cor:sourceImageFilename "COIN_X_1934_00460_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-460" ;
    cor:inventoryNumber "1934-460" ;
    cor:groupRaw "Gru 108" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-98-27/28" ;
    cor:leftPhotographDescription "Worn coin face with a central linear, monogrammatic, or architectural device and traces of a surrounding marginal legend."@en ;
    cor:rightPhotographDescription "Worn coin face with a circular central device and traces of a surrounding marginal legend."@en ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "photographFaceAssignment" ;
        cor:rawValue "Two coin photographs, left and right" ;
        cor:proposedValue "left photograph = obverse; right photograph = reverse" ;
        cor:reason "The card does not explicitly label the photographs."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the expansion of 'Gru 108', the calendar interpretation of '5/8/34', and the assignment of the two photographs to obverse and reverse." .

corid:coin-1934-460-obverse
    a nmo:Obverse .

corid:coin-1934-460-reverse
    a nmo:Reverse .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .
