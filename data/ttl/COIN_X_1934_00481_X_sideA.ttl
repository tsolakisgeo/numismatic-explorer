corid:coin-1934-481
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-481" ;
    dcterms:source corid:card-COIN_X_1934_00481_X_sideA ;
    nmo:hasObverse corid:coin-1934-481-obverse ;
    nmo:hasReverse corid:coin-1934-481-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00481_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00481_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-481 ;
    cor:sourceImageFilename "COIN_X_1934_00481_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-481" ;
    cor:inventoryNumber "1934-481" ;
    cor:groupRaw "Gru 129" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-99-31A/32A" ;
    cor:databaseLookupSource "direct_csv_index" ;
    cor:databaseLinkMethod "composite_inventory_key" ;
    cor:databaseInventoryCardID "808165284850286592" ;
    cor:databaseLinkedCoinID "-2076303648" ;
    cor:databaseStudyCollectionStatus false ;
    cor:databaseInventoryCardCreated "2025-02-19T16:09:09+02:00"^^xsd:dateTime ;
    cor:databaseInventoryCardModified "2026-01-14T11:35:18+02:00"^^xsd:dateTime ;
    cor:databaseInventoryCardCreator "ESPA2025. Herbst, J." ;
    cor:databaseCoinRecordCreated "2013-11-12T14:02:27+02:00"^^xsd:dateTime ;
    cor:databaseUserGroup "Corinth,Staff,Public" ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "groupRaw" ;
        cor:rawValue "Gru 129" ;
        cor:proposedValue "Group 129" ;
        cor:reason "The expansion of the handwritten abbreviation is inferred."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "excavationDateRaw" ;
        cor:rawValue "5/8/34" ;
        cor:reason "The card does not make the month-day order explicit."
    ] ;
    cor:uncertainReading [
        a cor:UncertainReading ;
        cor:field "photographFaceAssignment" ;
        cor:rawValue "Two unlabeled coin photographs, left and right" ;
        cor:proposedValue "left photograph = obverse; right photograph = reverse" ;
        cor:reason "The photographs are not explicitly labeled on the card."
    ] ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the expansion of 'Gru 129', the calendar interpretation of 5/8/34, and the assignment of the two photographs to obverse and reverse." .

corid:coin-1934-481-obverse
    a nmo:Obverse ;
    dcterms:description "Unlabeled left photograph: coin face with a central rectangular or monogrammatic device and traces of a surrounding marginal legend."@en ;
    cor:photographPosition "left" .

corid:coin-1934-481-reverse
    a nmo:Reverse ;
    dcterms:description "Unlabeled right photograph: coin face with a central cross-like device within a circular border and traces of a surrounding marginal legend."@en ;
    cor:photographPosition "right" .

corid:place-agora-sw-hoard
    a dcterms:Location ;
    skos:prefLabel "Agora SW Hoard"@en .
