corid:coin-1934-456
    a nmo:NumismaticObject ;
    dcterms:identifier "1934-456" ;
    dcterms:source corid:card-COIN_X_1934_00456_X_sideA ;
    nmo:hasObverse corid:coin-1934-456-obverse ;
    nmo:hasReverse corid:coin-1934-456-reverse ;
    nmo:hasFindspot corid:place-agora-sw-hoard .

corid:card-COIN_X_1934_00456_X_sideA
    a cor:InventoryCard ;
    dcterms:identifier "COIN_X_1934_00456_X_sideA" ;
    cor:documentsNumismaticObject corid:coin-1934-456 ;
    cor:sourceImageFilename "COIN_X_1934_00456_X_sideA.jpg" ;
    cor:transcriptionMethod "vision analysis from inventory-card image" ;
    cor:inventoryNumberRaw "1934-456" ;
    cor:inventoryNumber "1934-456" ;
    cor:groupRaw "Gru 104" ;
    cor:findspotRaw "Agora SW Hoard" ;
    cor:excavationDateRaw "5/8/34" ;
    cor:negativeNumberRaw "08-98-19/20" ;
    cor:leftPhotographDescription "Worn coin face with a central figural or monogrammatic device and traces of a surrounding marginal legend."@en ;
    cor:rightPhotographDescription "Worn coin face with a cross-like central device and traces of a surrounding marginal legend."@en ;
    cor:requiresHumanReview true ;
    cor:humanConfirmationNote "Confirm the expansion of 'Gru 104', the calendar interpretation of '5/8/34', and the assignment of the left and right photographs to obverse and reverse." .

corid:coin-1934-456-obverse
    a nmo:Obverse .

corid:coin-1934-456-reverse
